# VPS Bridge Configuration
# These variables are required for connecting to the VPS bridge gateway

# VPS Bridge URL (production server)
VPS_BRIDGE_URL=http://localhost:3003

# VPS Bridge API Key (for authentication)
VPS_BRIDGE_API_KEY=your_api_key_here

# n8n Configuration
# Base URL for the n8n editor (used for "View in n8n" button)
NEXT_PUBLIC_N8N_EDITOR_BASE_URL=http://localhost:5678

# ══════════════════════════════════════════════════════════
# Express OAuth Backend
# ══════════════════════════════════════════════════════════
# URL of the Express OAuth server (port 3001)
# Production: update to your actual domain (e.g. https://oauth.avry.io)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ══════════════════════════════════════════════════════════
# OAuth Configuration
# ══════════════════════════════════════════════════════════
# Base URL for OAuth redirect callbacks (no trailing slash)
# All OAuth redirect URIs now point to the Express backend:
#   http://localhost:3001/auth/{provider}/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:3001

# ── Google (Gmail, Drive, Sheets, Calendar — one OAuth app) ──
# Console: https://console.cloud.google.com
# Steps: Create project → Enable APIs (Gmail, Drive, Sheets, Calendar) →
#   OAuth consent screen (External) → Credentials → OAuth 2.0 Client ID (Web)
# Redirect URI: http://localhost:3001/auth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ── Microsoft (Outlook, Teams — one OAuth app) ──
# Console: https://portal.azure.com → Azure AD → App registrations
# Steps: New registration → Redirect URI: http://localhost:3001/auth/microsoft/callback
# API permissions: Mail.ReadWrite, Mail.Send, ChannelMessage.Send, offline_access
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ── Slack ──
# Console: https://api.slack.com/apps
# Steps: Create New App → OAuth & Permissions → Add redirect URL
# Scopes: channels:read, chat:write, users:read
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=

# ── GitHub ──
# Console: https://github.com/settings/developers
# Steps: New OAuth App → Callback URL: http://localhost:3001/auth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── Discord ──
# Console: https://discord.com/developers/applications
# Steps: New Application → OAuth2 → Redirect URI
# Scopes: identify, email, guilds, bot
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# ── Dropbox ──
# Console: https://www.dropbox.com/developers/apps
# Steps: Create app → Scoped access → Full Dropbox → Add redirect URI
OAUTH_DROPBOX_CLIENT_ID=
OAUTH_DROPBOX_CLIENT_SECRET=

# ── HubSpot ──
# Console: https://developers.hubspot.com/
# Steps: Create app → Auth tab → Redirect URL
# Scopes: contacts, deals, oauth
OAUTH_HUBSPOT_CLIENT_ID=
OAUTH_HUBSPOT_CLIENT_SECRET=

# ── Salesforce ──
# Console: https://developer.salesforce.com
# Steps: Setup → App Manager → New Connected App → Callback URL
# Scopes: api, refresh_token, offline_access
OAUTH_SALESFORCE_CLIENT_ID=
OAUTH_SALESFORCE_CLIENT_SECRET=

# ── Notion ──
# Console: https://www.notion.so/my-integrations
# Steps: New integration → type: Public → Redirect URI
OAUTH_NOTION_CLIENT_ID=
OAUTH_NOTION_CLIENT_SECRET=

# ── Trello ──
# Console: https://trello.com/power-ups/admin
# Steps: Create Power-Up → Generate API key → Allowed origins: http://localhost:3000
OAUTH_TRELLO_CLIENT_ID=
OAUTH_TRELLO_CLIENT_SECRET=

# ── Asana ──
# Console: https://app.asana.com/0/my-apps
# Steps: Create new app → Redirect URI
OAUTH_ASANA_CLIENT_ID=
OAUTH_ASANA_CLIENT_SECRET=

# ── Linear ──
# Console: https://linear.app/settings/api
# Steps: Create new OAuth application → Callback URL
OAUTH_LINEAR_CLIENT_ID=
OAUTH_LINEAR_CLIENT_SECRET=

# ── Intercom ──
# Console: https://developers.intercom.com
# Steps: New App → Authentication → Redirect URL
OAUTH_INTERCOM_CLIENT_ID=
OAUTH_INTERCOM_CLIENT_SECRET=

# ── Mailchimp ──
# Console: https://mailchimp.com/developer/
# Steps: Register → OAuth2 tab → Redirect URI
OAUTH_MAILCHIMP_CLIENT_ID=
OAUTH_MAILCHIMP_CLIENT_SECRET=

# ── Airtable ──
# Console: https://airtable.com/create/oauth
# Steps: Register new OAuth integration → Redirect URI
# Scopes: data.records:read, data.records:write
OAUTH_AIRTABLE_CLIENT_ID=
OAUTH_AIRTABLE_CLIENT_SECRET=

# ── Shopify ──
# Console: https://partners.shopify.com
# Steps: Create app → App setup → Allowed redirection URL
OAUTH_SHOPIFY_CLIENT_ID=
OAUTH_SHOPIFY_CLIENT_SECRET=

# ── Zendesk ──
# Console: https://developer.zendesk.com
# Steps: Admin Center → Apps → OAuth clients → Add client → Redirect URL
OAUTH_ZENDESK_CLIENT_ID=
OAUTH_ZENDESK_CLIENT_SECRET=
OAUTH_ZENDESK_SUBDOMAIN=
